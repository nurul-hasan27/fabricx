{
 "uid": "fabricx",
 "title": "FabricX fabric",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "tags": [
  "fabricx"
 ],
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "red",
    "name": "Fault injection",
    "target": {
     "type": "tags",
     "tags": [
      "fabricx"
     ],
     "limit": 200,
     "matchAny": true
    }
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Switches answering",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(fabricx_up)",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "type": "stat",
   "title": "BGP sessions Established",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(fabricx_bgp_peer_up)",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "type": "stat",
   "title": "BFD sessions up",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(fabricx_bfd_peer_up)",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "type": "stat",
   "title": "Exporter poll time",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "fabricx_poll_seconds",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "type": "state-timeline",
   "title": "BGP sessions (leaf view)",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "fabricx_bgp_peer_up{node=~\"leaf.*\"}",
     "legendFormat": "{{node}} -> {{peer_name}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "UP",
         "color": "green",
         "index": 1
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "rowHeight": 0.8,
    "legend": {
     "showLegend": false,
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "type": "state-timeline",
   "title": "BFD sessions (leaf view)",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "fabricx_bfd_peer_up{node=~\"leaf.*\"}",
     "legendFormat": "{{node}} -> {{peer_name}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "UP",
         "color": "green",
         "index": 1
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "rowHeight": 0.8,
    "legend": {
     "showLegend": false,
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "type": "timeseries",
   "title": "Leaf uplink utilisation (ECMP balance)",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "8 * irate(fabricx_iface_tx_bytes_total{node=~\"leaf.*\",iface=~\"eth1|eth2|Ethernet0|Ethernet4\"}[20s])",
     "legendFormat": "{{node}} {{iface}} tx",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 9
   },
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "irate over the last two exporter polls (5 s apart): the exact average rate between polls."
  },
  {
   "type": "timeseries",
   "title": "Interface drops (packets/s)",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (node, iface) (rate(fabricx_iface_tx_dropped_total[30s]) + rate(fabricx_iface_rx_dropped_total[30s])) > 0",
     "legendFormat": "{{node}} {{iface}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "pps"
    },
    "overrides": []
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 9
   },
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
  {
   "type": "timeseries",
   "title": "EVPN routes by type (all leaves)",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (type) (fabricx_evpn_routes)",
     "legendFormat": "{{type}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 7
   },
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  }
 ]
}