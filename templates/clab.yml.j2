# GENERATED by `fabricx generate` from inventory/fabric.yaml. Do not edit by hand.
name: {{ f.name }}
topology:
  nodes:
{% for sw in f.spines + f.leaves %}
{% if sw.nos == 'sonic-vs' %}
    {{ sw.name }}:
      kind: sonic-vs
      image: {{ f.sonic.image }}
      binds:
        - configs/{{ sw.name }}/frr.conf:/etc/fabricx/frr.conf:ro
        - configs/{{ sw.name }}/sonic-setup.sh:/opt/sonic-setup.sh:ro
        - ../src/fabricx/probe.py:/opt/probe.py:ro
      exec:
        - bash /opt/sonic-setup.sh
{% else %}
    {{ sw.name }}:
      kind: linux
      image: {{ f.frr_image }}
      binds:
        - configs/{{ sw.name }}/daemons:/etc/frr/daemons
        - configs/{{ sw.name }}/frr.conf:/etc/frr/frr.conf
        - configs/{{ sw.name }}/vtysh.conf:/etc/frr/vtysh.conf
        - ../src/fabricx/probe.py:/opt/probe.py:ro
{% if sw in f.leaves %}
        - configs/{{ sw.name }}/setup.sh:/opt/setup.sh:ro
        - configs/{{ sw.name }}/ports.sh:/opt/ports.sh:ro
      cmd: sh -c "sh /opt/setup.sh && exec /usr/lib/frr/docker-start"
      exec:
        - sh /opt/ports.sh
{% else %}
      exec:
        - sysctl -w net.ipv4.fib_multipath_hash_policy={{ f.ecmp_hash_policy }}
{% endif %}
{% endif %}
{% endfor %}
{% for h in f.hosts %}
    {{ h.name }}:
      kind: linux
      image: {{ f.host_image }}
      binds:
        - ../src/fabricx/probe.py:/opt/probe.py:ro
      exec:
        - ip link set eth1 mtu {{ f.host_mtu }}
        - ip addr add {{ h.ip }}/{{ f.vlan(h.vlan).subnet.prefixlen }} dev eth1
        - ip link set eth1 up
        - nohup sh -c 'for i in $(seq 60); do ip route replace default via {{ f.vlan(h.vlan).gateway }} dev eth1 && break; sleep 1; done' >/dev/null 2>&1 &
{% endfor %}
  links:
{% for lk in f.fabric_links() %}
    - endpoints: ["{{ lk.spine }}:{{ lk.spine_if }}", "{{ lk.leaf }}:{{ lk.leaf_if }}"]
      mtu: {{ f.fabric_mtu }}
{% endfor %}
{% for hl in f.host_links() %}
    - endpoints: ["{{ hl.leaf }}:{{ hl.leaf_if }}", "{{ hl.host }}:{{ hl.host_if }}"]
{% endfor %}
