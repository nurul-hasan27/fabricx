#!/bin/bash
# GENERATED by `fabricx generate`. Bring-up of SONiC-VS node {{ sw.name }} (underlay only).
# SONiC is configured through its databases: ports, IPs and the loopback go into CONFIG_DB, the
# *mgrd daemons turn them into kernel/ASIC state; then FRR (bgpd, bfdd) is started and given its config.
set -u
exec > >(tee -a /var/log/sonic-setup.log) 2>&1   # full log stays in the container
log() { echo "[sonic-setup] $(date +%T) $*"; }

# 1. wait until the ports exist (portsyncd writes PortInitDone when port init is finished)
for i in $(seq 1 120); do
  [ "$(sonic-db-cli APPL_DB EXISTS PORT_TABLE:PortInitDone 2>/dev/null)" = "1" ] && break; sleep 2
done
log "ports ready after ~$((i * 2)) s"

# 2. CONFIG_DB: fabric ports up, routed with a /31 each, plus Loopback0
{% for port, addr in ifaces %}
sonic-db-cli CONFIG_DB HSET "PORT|{{ port }}" admin_status up mtu {{ f.fabric_mtu }} >/dev/null
sonic-db-cli CONFIG_DB HSET "INTERFACE|{{ port }}" NULL NULL >/dev/null
sonic-db-cli CONFIG_DB HSET "INTERFACE|{{ port }}|{{ addr }}" NULL NULL >/dev/null
{% endfor %}
sonic-db-cli CONFIG_DB HSET "LOOPBACK_INTERFACE|Loopback0" NULL NULL >/dev/null
sonic-db-cli CONFIG_DB HSET "LOOPBACK_INTERFACE|Loopback0|{{ sw.loopback }}/32" NULL NULL >/dev/null

# 3. wait for intfmgrd to put the addresses on the kernel interfaces
for i in $(seq 1 60); do
  ok=1
{% for port, addr in ifaces %}
  ip -4 addr show {{ port }} 2>/dev/null | grep -q "{{ addr.split('/')[0] }}/" || ok=0
{% endfor %}
  ip -4 addr show Loopback0 2>/dev/null | grep -q "{{ sw.loopback }}/" || ok=0
  [ $ok = 1 ] && break; sleep 1
done
log "addresses on kernel interfaces: ok=$ok"

# 4. FRR. Wait for the image's own boot script (start.sh) to finish: it creates /var/run/frr and starts
#    zebra (with the FPM module to fpmsyncd). Starting bgpd before that made it exit (seen on CI).
for i in $(seq 1 120); do
  supervisorctl status start.sh 2>/dev/null | grep -q EXITED && supervisorctl status zebra | grep -q RUNNING && break
  sleep 1
done
log "image boot finished (start.sh exited, zebra running) after ~${i} s more"
supervisorctl start bgpd
sleep 2; supervisorctl status bgpd
{% if u.bfd_enabled %}
[ -d /var/run/frr ] || log "WARNING: /var/run/frr missing (FRR daemons drop to user frr and cannot create it)"
# bfdd ships in the image but SONiC-VS has no supervisor entry for it: run it like supervisord runs the
# other FRR daemons (foreground, vty on 127.0.0.1), detached, with its own log.
if ! pgrep -x bfdd >/dev/null; then
  nohup /usr/lib/frr/bfdd -A 127.0.0.1 >/var/log/bfdd.log 2>&1 &
fi
sleep 2; pgrep -x bfdd >/dev/null && log "bfdd running" || { log "bfdd NOT running:"; tail -5 /var/log/bfdd.log; }
{% endif %}
for i in $(seq 1 30); do vtysh -c 'show bgp summary' >/dev/null 2>&1 && break; sleep 1; done
vtysh -f /etc/fabricx/frr.conf
log "FRR configured"
sleep 3; supervisorctl status bgpd; pgrep -a bgpd || log "bgpd NOT running after config"
