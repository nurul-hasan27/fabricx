#!/bin/sh
# GENERATED by `fabricx generate`. Attach the host-facing ports of {{ sw.name }} to their VLAN bridges.
# Runs after containerlab has wired the links (clab `exec`). That can happen before setup.sh (started by the
# container's own command) has built the bridges, so wait for each bridge, at most 30 s.
set -e
{% for hl in ports %}
# --- host port {{ hl.leaf_if }} -> {{ hl.host }}
for i in $(seq 60); do ip link show br{{ f.vlan(f.hosts_by_name()[hl.host].vlan).id }} >/dev/null 2>&1 && break; sleep 0.5; done
ip link set {{ hl.leaf_if }} master br{{ f.vlan(f.hosts_by_name()[hl.host].vlan).id }}
ip link set {{ hl.leaf_if }} up
{% endfor %}
{% if vrfs %}

# --- L3VNI check-and-repair (workaround for an FRR start-up race, seen on CI) ---------------------------
# If bgpd gets zebra's L3VNI announcement before it has learned the VRF's id, it creates a second, automatic
# BGP instance that owns the L3VNI, and the configured instance never originates Type-5 routes. Reproduced
# on purpose by configuring 'vrf X / vni N' before 'router bgp ... vrf X'. Check = this leaf originates a
# Type-5 for each of its subnets; repair = withdraw and re-add the L3VNI (the empty automatic instance stays
# behind, harmless). Logged in /var/log/fabricx-heal.log so CI can count how often it fires.
t5() { vtysh -c 'show bgp l2vpn evpn route type prefix self-originate' 2>/dev/null; }
have_all() {
{% for v in vlans %}
  t5 | grep -qF '[{{ v.subnet.prefixlen }}]:[{{ v.subnet.network_address }}]' || return 1
{% endfor %}
  return 0
}
for i in $(seq 1 20); do have_all && break; sleep 1; done
if have_all; then
  echo "[fabricx-heal] {{ sw.name }}: own Type-5 routes present after ~${i} s" >> /var/log/fabricx-heal.log
else
  echo "[fabricx-heal] {{ sw.name }}: own Type-5 missing after 20 s -> re-adding L3VNI(s)" | tee -a /var/log/fabricx-heal.log
{% for vrf in vrfs %}
  vtysh -c 'configure terminal' -c 'vrf {{ vrf.name }}' -c 'no vni {{ vrf.l3vni }}' -c 'exit-vrf'
  sleep 2
  vtysh -c 'configure terminal' -c 'vrf {{ vrf.name }}' -c 'vni {{ vrf.l3vni }}' -c 'exit-vrf'
{% endfor %}
  for i in $(seq 1 20); do have_all && break; sleep 1; done
  have_all && r=repaired || r="STILL MISSING"
  echo "[fabricx-heal] {{ sw.name }}: after re-adding L3VNI(s): $r" | tee -a /var/log/fabricx-heal.log
fi
{% endif %}
