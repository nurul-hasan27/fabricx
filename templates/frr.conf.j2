! GENERATED by `fabricx generate`. Do not edit by hand.
frr defaults datacenter
hostname {{ sw.name }}
service integrated-vtysh-config
!
{# SONiC-VS: interface and loopback addresses live in CONFIG_DB (see sonic-setup.sh), not in FRR. #}
{% if not sonic %}
interface lo
 ip address {{ sw.loopback }}/32
{% if routing and u.protocol == 'ospf' %}
 ip ospf area 0
{% elif routing and u.protocol == 'isis' %}
 ip router isis FABRIC
 isis passive
{% endif %}
!
{% for ifname, addr in ifaces %}
interface {{ ifname }}
 description fabric link
 ip address {{ addr }}
{% if routing and u.protocol == 'ospf' %}
 ip ospf area 0
 ip ospf network point-to-point
 ip ospf hello-interval {{ u.igp_hello_s }}
 ip ospf dead-interval {{ u.igp_dead_s }}
{% if u.bfd_enabled %}
 ip ospf bfd
 ip ospf bfd profile dc
{% endif %}
{% elif routing and u.protocol == 'isis' %}
 ip router isis FABRIC
 isis network point-to-point
 isis circuit-type level-2-only
 isis hello-interval {{ u.igp_hello_s }}
 isis hello-multiplier {{ (u.igp_dead_s / u.igp_hello_s) | int }}
{% if u.bfd_enabled %}
 isis bfd
 isis bfd profile dc
{% endif %}
{% endif %}
!
{% endfor %}
{% endif %}
{% if routing %}
{% if u.bfd_enabled %}
bfd
 profile dc
  detect-multiplier {{ u.bfd_multiplier }}
  receive-interval {{ u.bfd_interval_ms }}
  transmit-interval {{ u.bfd_interval_ms }}
 exit
 !
exit
!
{% endif %}
{% if u.protocol == 'ospf' %}
router ospf
 ospf router-id {{ sw.loopback }}
exit
!
{% elif u.protocol == 'isis' %}
router isis FABRIC
 net {{ isis_net }}
 is-type level-2-only
 metric-style wide
exit
!
{% endif %}
{% if u.protocol == 'ebgp' %}
router bgp {{ sw.asn }}
 bgp router-id {{ sw.loopback }}
 no bgp ebgp-requires-policy
 neighbor FABRIC peer-group
 neighbor FABRIC remote-as external
 neighbor FABRIC timers {{ u.bgp_keepalive }} {{ u.bgp_hold }}
{% if u.bfd_enabled %}
 neighbor FABRIC bfd
 neighbor FABRIC bfd profile dc
{% endif %}
{% for n in nbrs %}
 neighbor {{ n.peer_ip }} peer-group FABRIC
 neighbor {{ n.peer_ip }} description {{ n.peer }}
{% endfor %}
 !
 address-family ipv4 unicast
  network {{ sw.loopback }}/32
  maximum-paths {{ u.max_paths }}
 exit-address-family
 !
 address-family l2vpn evpn
  neighbor FABRIC activate
{% if is_leaf %}
  advertise-all-vni
{% endif %}
 exit-address-family
exit
!
{% else %}
router bgp {{ u.ibgp_asn }}
 bgp router-id {{ sw.loopback }}
 no bgp default ipv4-unicast
 neighbor FABRIC peer-group
 neighbor FABRIC remote-as internal
 neighbor FABRIC update-source lo
 neighbor FABRIC timers {{ u.bgp_keepalive }} {{ u.bgp_hold }}
{% for n in nbrs %}
 neighbor {{ n.peer_ip }} peer-group FABRIC
 neighbor {{ n.peer_ip }} description {{ n.peer }}
{% endfor %}
 !
 address-family l2vpn evpn
  neighbor FABRIC activate
{% if not is_leaf %}
  neighbor FABRIC route-reflector-client
{% else %}
  advertise-all-vni
{% endif %}
 exit-address-family
exit
!
{% endif %}
{% for vrf in vrfs %}
{# Order matters: the BGP VRF instance must exist BEFORE zebra announces the L3VNI, otherwise bgpd can
   create a second, automatic instance for the VRF and never originate Type-5 routes (seen on CI). #}
router bgp {{ sw.asn if u.protocol == 'ebgp' else u.ibgp_asn }} vrf {{ vrf.name }}
 bgp router-id {{ sw.loopback }}
 !
 address-family ipv4 unicast
  redistribute connected
 exit-address-family
 !
 address-family l2vpn evpn
  advertise ipv4 unicast
 exit-address-family
exit
!
vrf {{ vrf.name }}
 vni {{ vrf.l3vni }}
exit-vrf
!
{% endfor %}
{% endif %}
line vty
!
